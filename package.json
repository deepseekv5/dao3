{
  "name": "laoyou-metaverse",
  "version": "3.1.1",
  "private": false,
  "description": "老攸元宇宙：跑在自己机器上的体素元宇宙。编辑器 + 运行时 + VOXA 建模负责创作，服务端社区负责发布快照、账号、好友、关注与评论。引擎接口层与 dao3.fun 的 GameAPI 语义兼容。零第三方运行时依赖。",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "main": "server.js",
  "bin": {
    "laoyou": "start.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseekv5/dao3.git"
  },
  "homepage": "https://deepseekv5.github.io/dao3/",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "start": "node start.mjs",
    "serve": "node server.js",
    "build:atlas": "node scripts/build-block-atlas.mjs",
    "build:api-ref": "node scripts/api-audit.mjs && node scripts/build-api-ref.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:play": "node scripts/build-play.mjs",
    "audit:api": "node scripts/api-audit.mjs",
    "test": "node test/runtime_parity.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:play": "node test/play.mjs",
    "test:terrain": "node test/terrain.mjs",
    "test:ai": "node test/ai.mjs",
    "package": "node scripts/build-portable.mjs",
    "installers": "node scripts/build-installers.mjs",
    "check:dist": "node scripts/check-distribution.mjs",
    "fetch:official": "node scripts/fetch-official-project.mjs",
    "fetch:audio": "node scripts/fetch-official-audio.mjs",
    "test:pkg": "node test/packaging.mjs",
    "test:community": "node test/community.test.mjs",
    "test:platform": "node test/platform.test.mjs",
    "test:realtime": "node test/realtime.test.mjs",
    "test:vox": "node test/vox.test.mjs",
    "test:ide": "node test/ide.test.mjs",
    "test:pause": "node test/pause.test.mjs"
  },
  "files": [
    "server.js",
    "server/community.mjs",
    "start.mjs",
    "scripts",
    "play-src",
    "docs",
    "data",
    "official-project/cids.json",
    "official-project/racing-template.json.gz",
    "official-project/racing-assets",
    "public/index.html",
    "public/community.html",
    "public/editor.html",
    "public/voxa.html",
    "public/site.html",
    "public/data/api-impl.json",
    "public/manual.html",
    "public/js",
    "public/css",
    "public/img",
    "public/vendor",
    "public/data/thumbnails",
    "public/data/block-atlas.json",
    "public/data/block-atlas.png",
    "public/data/api-members.json",
    "public/data/api-methods.json",
    "public/data/api-spec.json",
    "run.sh",
    "run-win.ps1",
    "启动-Windows.bat",
    "启动-macOS.command",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "voxel",
    "metaverse",
    "ugc",
    "editor",
    "game-engine",
    "community",
    "three.js"
  ],
  "dependencies": {},
  "devDependencies": {}
}
